Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Our Robot1
        - /Opponent Markers1
        - /Field Map CAD Markers1
        - /Dynamic PointCloud1
        - /Static Obstacle Cloud1
        - /Ground Cloud1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 800
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 14
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Our Robot (A-Team)
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /our_robot/markers
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Opponent Robot & Bucket
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /opponent_robot/markers
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Field Map CAD Markers
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /field_map_markers
      Value: true

    - Alpha: 0.9
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 255; 200
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Dynamic PointCloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.04
      Style: Points
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dynamic_cloud
      Use Fixed Frame: true
      Value: true

    - Alpha: 0.6
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 160; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Static Obstacle Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.02
      Style: Flat Squares
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /obstacle_cloud
      Use Fixed Frame: true
      Value: true

    - Alpha: 0.3
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 100; 100; 100
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Ground Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.01
      Style: Flat Squares
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground_cloud
      Use Fixed Frame: true
      Value: true

    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true

  Enabled: true
  Global Options:
    Background Color: 25; 28; 38
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14.0
      Eye:
        X: 7.0
        Y: -4.0
        Z: 10.0
      Focal Point:
        X: 7.0
        Y: 6.5
        Z: 0.5
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.70
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 1.57
